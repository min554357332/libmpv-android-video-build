@@ -128,6 +132,9 @@ struct mpv_handle {
     void (*wakeup_cb)(void *d);
     void *wakeup_cb_ctx;
     int wakeup_pipe[2];
+    // Defensive liveness probe state for wakeup_cb; see wakeup_cb_is_callable().
+    void *wakeup_cb_probed;
